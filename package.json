{
  "name": "kindle-backend",
  "version": "1.0.0",
  "description": "Modern Bun backend for Kindle application",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "bun run index.js",
    "dev": "bun --watch index.js",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "lint": "bun run eslint . --ext .js,.mjs,.ts",
    "lint:fix": "bun run eslint . --ext .js,.mjs,.ts --fix",
    "format": "bun run prettier --write .",
    "build": "bun build index.js --outdir ./dist --target bun",
    "validate": "bun run lint && bun test",
    "install:deps": "bun install",
    "clean": "rm -rf dist node_modules",
    "type-check": "bun run tsc --noEmit"
  },
  "keywords": ["kindle", "books", "express", "bun", "typescript", "api"],
  "author": "Your Name",
  "license": "MIT",
  "engines": {
    "bun": ">=1.0.0"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "express-rate-limit": "^7.1.5",
    "compression": "^1.7.4",
    "express-validator": "^7.0.1",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.6.3",
    "multer": "^1.4.5-lts.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/morgan": "^1.9.9",
    "@types/compression": "^1.7.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^1.4.11",
    "@types/uuid": "^9.0.7",
    "eslint": "^8.51.0",
    "@typescript-eslint/eslint-plugin": "^6.7.0",
    "@typescript-eslint/parser": "^6.7.0",
    "eslint-config-prettier": "^9.0.0",
    "prettier": "^3.0.3",
    "typescript": "^5.2.2",
    "@types/bun": "latest"
  },
  "eslintConfig": {
    "extends": [
      "eslint:recommended",
      "@typescript-eslint/recommended",
      "prettier"
    ],
    "parser": "@typescript-eslint/parser",
    "plugins": ["@typescript-eslint"],
    "env": {
      "node": true,
      "es2022": true
    },
    "parserOptions": {
      "ecmaVersion": 2022,
      "sourceType": "module"
    },
    "rules": {
      "no-console": "off",
      "@typescript-eslint/no-unused-vars": ["error", { "argsIgnorePattern": "^_" }],
      "prefer-const": "error",
      "no-var": "error"
    }
  },
  "prettier": {
    "semi": true,
    "trailingComma": "es5",
    "singleQuote": true,
    "printWidth": 80,
    "tabWidth": 2
  },
  "bun": {
    "test": {
      "preload": ["./test-setup.js"]
    }
  }
}